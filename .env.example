# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Reverse-proxy hops to trust in deployment. Leave at 0 for direct local use.
TRUST_PROXY_HOPS=0

# Postgres. If a native Postgres already holds 5432, set the host port Docker
# publishes on here and use the same port in DATABASE_URL.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://scholarshield:scholarshield@localhost:5432/scholarshield

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally, S3/R2 in deploy)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=scholarshield-documents
S3_ACCESS_KEY=scholarshield
S3_SECRET_KEY=scholarshield
S3_FORCE_PATH_STYLE=true
# Where a BROWSER reaches object storage, for signed document URLs. Needed when
# the API reaches storage by a private name (http://minio:9000 in compose).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# OCR + forensics service
OCR_SERVICE_URL=http://localhost:8000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-value
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_HOURS=12
# Keys the anonymous-tip submitter hash. Generate like JWT_SECRET; falls back to it when unset.
TIP_HASH_SECRET=

# Mail — unset locally: sign-in links are printed to the API log instead.
# Set to e.g. smtps://user:pass@smtp.example.com:465 in deploy. Required in production.
SMTP_URL=
MAIL_FROM=ScholarShield <no-reply@scholarshield.local>
INVITE_TTL_DAYS=7

# Uploads
MAX_UPLOAD_BYTES=12582912

# Retention — documents purged this many days after a terminal decision
DOCUMENT_RETENTION_DAYS=180

# Scholarship cycle configuration
SCHOLARSHIP_INCOME_CEILING=250000
CYCLE_DEADLINE=2026-07-31

# The cycle every public submission joins. Set by the server, never the form.
CURRENT_CYCLE=2026
