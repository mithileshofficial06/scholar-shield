{
  "name": "scholar-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Scholarship fraud risk-triage for college committees",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "test:integration": "npm run test:integration --workspace apps/api",
    "test:integration:setup": "npm run test:integration:setup --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate --workspace apps/api",
    "seed": "npm run seed --workspace apps/api --",
    "metrics": "npm run metrics --workspace apps/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "seed:documents": "npm run seed:documents --workspace apps/api",
    "worker": "npm run worker --workspace apps/api",
    "reprocess": "npm run reprocess --workspace apps/api --",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2"
  }
}
